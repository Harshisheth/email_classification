        "jsCode": "const data = $json;\n\n// Collect all text fields from the incoming item\nconst text = Object.values(data)\n  .filter(value => typeof value === 'string')\n  .join('\\n');\n\n// Indian phone number patterns\nconst phonePatterns = [\n  /(?:\\+91[\\s-]?)?[6-9]\\d{4}[\\s-]?\\d{5}/g,\n  /(?:\\+91[\\s-]?)?[6-9]\\d{9}/g\n];\n\nlet phone = '';\n\nfor (const pattern of phonePatterns) {\n  const matches = text.match(pattern);\n\n  if (matches && matches.length > 0) {\n    phone = matches[0].trim();\n    break;\n  }\n}\n\n// Return original data + extracted phone\nreturn {\n  json: {\n    ...data,\n    phone_from_email: phone\n  }\n};"
      },
